# Copy to .env and fill in. Never commit .env.

# Bliz API host that serves /api/v1/attribution/mobile/init
#   iOS Simulator:    http://localhost:3008
#   Android Emulator: http://10.0.2.2:3008
#   Real phone:       http://<your-computer-LAN-IP>:3008  (or your deployed API URL)
EXPO_PUBLIC_BLIZ_API_URL=https://YOUR_BLIZ_API_HOST

# Public key from the Bliz dashboard (starts with pk_live_). Safe to ship in an app.
# Do NOT use your secret key (sk_live_) here - mobile/init rejects it.
EXPO_PUBLIC_BLIZ_PK=pk_live_YOUR_PUBLIC_KEY
